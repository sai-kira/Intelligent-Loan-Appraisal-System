# =============================================================================
# Central Bank of India - Intelligent Loan Appraisal System (ILAS)
# Environment Configuration Template
# =============================================================================

# Google Gemini API Key (Used for LLM Underwriting & Gemini-Embedding-2)
GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL (Requires pgvector extension)
DATABASE_URL=postgresql://postgres:password@localhost:5432/CentralBankDB

# Credit Manager Access Passcode (Used for HITL Approval & Overrides)
CREDIT_MANAGER_PASSCODE=CBOI_ADMIN

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Service Configuration
FRONTEND_PORT=8501
